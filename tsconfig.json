{
    "compilerOptions": {
        "module": "commonjs",
        "moduleResolution": "node10",
        "ignoreDeprecations": "6.0",
        "strict": false,
        "types": [
            "node",
            "jest",
            "multer"
        ],
        "target": "esnext",
        "declaration": false,
        "noImplicitAny": false,
        "sourceMap": true,
        "removeComments": true,
        "importHelpers": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "strictPropertyInitialization": false,
        "resolveJsonModule": true,
        "outDir": "./dist",
        "incremental": true,
        "skipLibCheck": true,
        "allowJs": true,
        "paths": {
            "@/*": [
                "./src/*"
            ],
            // https-proxy-agent 9 为 ESM-only 且未声明顶层 types 字段，node10 模块解析无法定位类型定义
            "https-proxy-agent": [
                "./node_modules/https-proxy-agent/dist/index.d.ts"
            ]
        },
        "lib": [
            "esnext",
            "dom",
            "dom.iterable",
            "scripthost"
        ]
    },
    "include": [
        "src",
        "test",
        "benchmarks",
        "scripts",
        "*.ts",
        "*.mjs",
        "*.js"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
